# Copy this file to .env.local and fill in your Supabase values.
# Get them from: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Fal.ai (for AI Photo Studio). Get key from fal.ai dashboard.
FAL_KEY=

# Optional: bucket for AI Photo Studio uploads (default: ai_photo_studio)
# SUPABASE_AI_INPUT_BUCKET=ai_photo_studio
